   "source": [
    "## 6. Vocabulary: words → integer IDs\n",
    "We give every word an ID. Four special tokens:\n",
    "\n",
    "| token | meaning |\n",
    "|---|---|\n",
    "| `<pad>` | filler so sentences in a batch have equal length |\n",
    "| `<sos>` | start of sentence: the decoder's first input |\n",
    "| `<eos>` | end of sentence: the decoder emits this to say \"I'm done\" |\n",
    "| `<unk>` | any word not in the vocabulary (rare/unseen words) |\n",
    "\n",
    "**Important:** the vocabulary is built from the **training set only**. Building it from test data would be data leakage."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "2371d0d8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Source vocab size: 13412 | Target vocab size: 16176\n"
     ]
    }
   ],
   "source": [
    "PAD, SOS, EOS, UNK = 0, 1, 2, 3\n",
    "\n",
    "class Vocab:\n",
    "    def __init__(self, sentences, min_freq):\n",
    "        counts = Counter(w for s in sentences for w in s)\n",
    "        self.itos = [\"<pad>\", \"<sos>\", \"<eos>\", \"<unk>\"] + \\\n",
    "                    [w for w, c in counts.most_common() if c >= min_freq]\n",
    "        self.stoi = {w: i for i, w in enumerate(self.itos)}\n",
    "    def encode(self, tokens):\n",
    "        return [self.stoi.get(w, UNK) for w in tokens]\n",
    "    def decode(self, ids):\n",
    "        words = []\n",
    "        for i in ids:\n",
    "            if i == EOS: break\n",
    "            if i in (PAD, SOS): continue\n",
    "            words.append(self.itos[i])\n",
    "        return words\n",
    "    def __len__(self):\n",
    "        return len(self.itos)\n",
    "\n",
    "src_vocab = Vocab([s for s, _ in train_pairs], MIN_FREQ)\n",
    "trg_vocab = Vocab([t for _, t in train_pairs], MIN_FREQ)\n",
    "print(\"Source vocab size:\", len(src_vocab), \"| Target vocab size:\", len(trg_vocab))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2e9b59cd",
   "metadata": {},
   "source": [
    "## 7. Dataset and batching\n",
    "Each sentence becomes a tensor of IDs. The target gets `<sos>` at the front and `<eos>` at the end.\n",
    "Sentences in a batch have different lengths, so `collate_fn` pads them with `<pad>` and also returns the *true* source lengths (the encoder needs them to ignore padding)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "e9142d29",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "src batch: torch.Size([128, 24]) | trg batch: torch.Size([128, 27])\n"
     ]
    }
   ],
   "source": [
    "class TranslationDataset(Dataset):\n",
    "    def __init__(self, pairs):\n",
    "        self.pairs = pairs\n",
    "    def __len__(self):\n",
    "        return len(self.pairs)\n",
    "    def __getitem__(self, i):\n",
    "        src, trg = self.pairs[i]\n",
    "        src_ids = torch.tensor(src_vocab.encode(src), dtype=torch.long)\n",
    "        trg_ids = torch.tensor([SOS] + trg_vocab.encode(trg) + [EOS], dtype=torch.long)\n",
    "        return src_ids, trg_ids\n",
    "\n",
    "def collate_fn(batch):\n",
    "    srcs, trgs = zip(*batch)\n",
    "    src_lens = torch.tensor([len(s) for s in srcs], dtype=torch.long)\n",
    "    srcs = pad_sequence(srcs, batch_first=True, padding_value=PAD)   # (B, S)\n",
    "    trgs = pad_sequence(trgs, batch_first=True, padding_value=PAD)   # (B, T)\n",
    "    return srcs, src_lens, trgs\n",
    "\n",
    "train_loader = DataLoader(TranslationDataset(train_pairs), BATCH_SIZE, shuffle=True,  collate_fn=collate_fn)\n",
    "val_loader   = DataLoader(TranslationDataset(val_pairs),   BATCH_SIZE, shuffle=False, collate_fn=collate_fn)\n",
    "test_loader  = DataLoader(TranslationDataset(test_pairs),  BATCH_SIZE, shuffle=False, collate_fn=collate_fn)\n",
    "\n",
    "s, l, t = next(iter(train_loader))\n",
    "print(\"src batch:\", s.shape, \"| trg batch:\", t.shape)   # (B, S) and (B, T)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "12403290",
   "metadata": {},
   "source": [
    "## 8. The model\n",
    "### Encoder\n",
    "`Embedding` turns each word ID into a dense vector (words with similar meaning get similar vectors as training proceeds). The LSTM reads the sequence and we keep only its **final hidden state `h` and cell state `c`**: this pair is the *context vector*.\n",
    "\n",
    "`pack_padded_sequence` tells the LSTM where each sentence really ends, so the final state comes from the last *real* word, not from padding.\n",
    "\n",
    "### Decoder\n",
    "At each step it takes **one** token, updates its LSTM state, and a `Linear` layer turns the output into a score for every word in the target vocabulary (*logits*). Softmax + argmax would pick the next word.\n",
    "\n",
    "### Seq2Seq wrapper (teacher forcing)\n",
    "During training we loop over target positions. At each step the input is the true previous word (with probability `TF_RATIO`) or the model's own previous prediction (otherwise)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "b2f14293",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Trainable parameters: 23,229,232\n"
     ]
    }
   ],
   "source": [
    "class Encoder(nn.Module):\n",
    "    def __init__(self, vocab_size, emb_dim, hid_dim, n_layers, dropout):\n",
    "        super().__init__()\n",
    "        self.embedding = nn.Embedding(vocab_size, emb_dim, padding_idx=PAD)\n",
    "        self.lstm = nn.LSTM(emb_dim, hid_dim, n_layers, batch_first=True,\n",
    "                            dropout=dropout if n_layers > 1 else 0.0)\n",
    "        self.dropout = nn.Dropout(dropout)\n",
    "\n",
    "    def forward(self, src, src_lens):\n",
    "        # src: (B, S)\n",
    "        emb = self.dropout(self.embedding(src))                       # (B, S, emb)\n",
    "        packed = pack_padded_sequence(emb, src_lens.cpu(), batch_first=True, enforce_sorted=False)\n",
    "        _, (h, c) = self.lstm(packed)                                  # h, c: (layers, B, hid)\n",
    "        return h, c                                                    # the context vector\n",
    "\n",
    "\n",
    "class Decoder(nn.Module):\n",
    "    def __init__(self, vocab_size, emb_dim, hid_dim, n_layers, dropout):\n",
    "        super().__init__()\n",
    "        self.embedding = nn.Embedding(vocab_size, emb_dim, padding_idx=PAD)\n",
    "        self.lstm = nn.LSTM(emb_dim, hid_dim, n_layers, batch_first=True,\n",
    "                            dropout=dropout if n_layers > 1 else 0.0)\n",
    "        self.fc_out = nn.Linear(hid_dim, vocab_size)\n",
    "        self.dropout = nn.Dropout(dropout)\n",
    "\n",
    "    def forward(self, token, h, c):\n",
    "        # token: (B,) -> one word per sentence in the batch\n",
    "        emb = self.dropout(self.embedding(token)).unsqueeze(1)         # (B, 1, emb)\n",
    "        out, (h, c) = self.lstm(emb, (h, c))                           # out: (B, 1, hid)\n",
    "        logits = self.fc_out(out.squeeze(1))                           # (B, trg_vocab)\n",
    "        return logits, h, c\n",
    "\n",
    "\n",
    "class Seq2Seq(nn.Module):\n",
    "    def __init__(self, encoder, decoder):\n",
    "        super().__init__()\n",
    "        self.encoder, self.decoder = encoder, decoder\n",
    "\n",
    "    def forward(self, src, src_lens, trg, tf_ratio=0.5):\n",
    "        B, T = trg.shape\n",
    "        V = self.decoder.fc_out.out_features\n",
    "        outputs = torch.zeros(B, T, V, device=src.device)\n",
    "        h, c = self.encoder(src, src_lens)          # encode the whole source sentence once\n",
    "        token = trg[:, 0]                           # first decoder input is <sos>\n",
    "        for t in range(1, T):\n",
    "            logits, h, c = self.decoder(token, h, c)\n",
    "            outputs[:, t] = logits\n",
    "            use_teacher = random.random() < tf_ratio\n",
    "            token = trg[:, t] if use_teacher else logits.argmax(1)\n",
    "        return outputs                              # (B, T, V); position 0 is unused\n",
    "\n",
    "\n",
    "enc = Encoder(len(src_vocab), EMB_DIM, HID_DIM, N_LAYERS, DROPOUT)\n",
    "dec = Decoder(len(trg_vocab), EMB_DIM, HID_DIM, N_LAYERS, DROPOUT)\n",
    "model = Seq2Seq(enc, dec).to(device)\n",
    "\n",
    "# Small-weight init helps LSTMs train stably\n",
    "for p in model.parameters():\n",
    "    nn.init.uniform_(p, -0.08, 0.08)\n",
    "\n",
    "print(\"Trainable parameters:\", f\"{sum(p.numel() for p in model.parameters() if p.requires_grad):,}\")"
   ]
