    "## 9. Training\n",
    "- **Loss:** cross-entropy between predicted word distribution and the true next word. `ignore_index=PAD` so padding doesn't count.\n",
    "- **Shift by one:** `outputs[:, 1:]` (predictions) are compared with `trg[:, 1:]` (true words), because the model predicts word *t* from word *t-1*.\n",
    "- **Adam** optimizer; **gradient clipping** to avoid exploding gradients.\n",
    "- After each epoch we compute validation loss (no teacher forcing, no dropout) and save the best model."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d3ac73c7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Epoch 01 | train loss 5.839 | val loss 5.768 (ppl 319.9) | 185s\n"
     ]
    }
   ],
   "source": [
    "criterion = nn.CrossEntropyLoss(ignore_index=PAD)\n",
    "optimizer = torch.optim.Adam(model.parameters(), lr=LR)\n",
    "\n",
    "def run_epoch(loader, train, tf_ratio):\n",
    "    model.train(train)\n",
    "    total = 0.0\n",
    "    with torch.set_grad_enabled(train):\n",
    "        for src, src_lens, trg in loader:\n",
    "            src, trg = src.to(device), trg.to(device)\n",
    "            out = model(src, src_lens, trg, tf_ratio)\n",
    "            loss = criterion(out[:, 1:].reshape(-1, out.shape[-1]), trg[:, 1:].reshape(-1))\n",
    "            if train:\n",
    "                optimizer.zero_grad()\n",
    "                loss.backward()\n",
    "                nn.utils.clip_grad_norm_(model.parameters(), CLIP)\n",
    "                optimizer.step()\n",
    "            total += loss.item()\n",
    "    return total / len(loader)\n",
    "\n",
    "train_losses, val_losses, best_val = [], [], float(\"inf\")\n",
    "for epoch in range(1, EPOCHS + 1):\n",
    "    t0 = time.time()\n",
    "    tr = run_epoch(train_loader, True, TF_RATIO)\n",
    "    va = run_epoch(val_loader, False, 0.0)       # 0.0 = decoder uses its own predictions, like at test time\n",
    "    train_losses.append(tr); val_losses.append(va)\n",
    "    if va < best_val:\n",
    "        best_val = va\n",
    "        torch.save(model.state_dict(), \"best_seq2seq.pt\")\n",
    "    print(f\"Epoch {epoch:02d} | train loss {tr:.3f} | val loss {va:.3f} (ppl {math.exp(va):.1f}) | {time.time()-t0:.0f}s\")\n",
    "\n",
    "plt.plot(train_losses, label=\"train\"); plt.plot(val_losses, label=\"val\")\n",
    "plt.xlabel(\"epoch\"); plt.ylabel(\"loss\"); plt.legend(); plt.title(\"Training curves\"); plt.show()"
   ]
