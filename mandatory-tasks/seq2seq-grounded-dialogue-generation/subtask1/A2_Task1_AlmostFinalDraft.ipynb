    " \n",
    "import pandas as pd\n",
    "\n",
    "def find_data_file(folder):\n",
    "    cands = []\n",
    "    for root, _, files in os.walk(folder):\n",
    "        for f in files:\n",
    "            if f.lower().endswith((\".txt\", \".tsv\", \".csv\")):\n",
    "                p = os.path.join(root, f)\n",
    "                cands.append((os.path.getsize(p), p))\n",
    "    assert cands, \"No .txt/.tsv/.csv file found. Check the listing above.\"\n",
    "    return max(cands)[1]\n",
    "\n",
    "def load_pairs(path):\n",
    "    pairs = []\n",
    "    if path.lower().endswith(\".csv\"):\n",
    "        df = pd.read_csv(path)\n",
    "        cols = list(df.columns)\n",
    "        en_col = next((c for c in cols if \"eng\" in str(c).lower()), cols[0])\n",
    "        fr_col = next((c for c in cols if \"fr\" in str(c).lower()), cols[1])\n",
    "        for en, fr in zip(df[en_col].astype(str), df[fr_col].astype(str)):\n",
    "            if en.strip() and fr.strip():\n",
    "                pairs.append((en.strip(), fr.strip()))\n",
    "    else:\n",
    "        with open(path, encoding=\"utf-8\") as f:\n",
    "            for line in f:\n",
    "                parts = line.rstrip(\"\\n\").split(\"\\t\")\n",
    "                if len(parts) >= 2 and parts[0].strip() and parts[1].strip():\n",
    "                    pairs.append((parts[0].strip(), parts[1].strip()))   # ignore any 3rd column\n",
    "    return pairs\n",
    "\n",
    "DATA_PATH = find_data_file(DATA_DIR)      # or set manually, e.g. DATA_PATH = \"./eng-french/fra.txt\"\n",
    "print(\"Using file:\", DATA_PATH)\n",
    "raw_pairs = load_pairs(DATA_PATH)\n",
    "print(\"Total pairs in file:\", len(raw_pairs))\n",
    "for en, fr in raw_pairs[:5]:\n",
    "    print(\"EN:\", en, \"\\nFR:\", fr, \"\\n\")"
