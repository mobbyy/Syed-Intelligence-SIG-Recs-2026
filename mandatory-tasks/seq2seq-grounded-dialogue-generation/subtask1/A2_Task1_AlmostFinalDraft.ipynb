    "## 10. Inference: greedy decoding\n",
    "At test time there is no true target. The decoder starts with `<sos>`, picks the **most probable word** (`argmax`), feeds it back in, and repeats until it produces `<eos>` or hits a max length. This is **greedy decoding** (later experiments can try beam search)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1a146707",
   "metadata": {},
   "outputs": [],
   "source": [
    "model.load_state_dict(torch.load(\"best_seq2seq.pt\", map_location=device))\n",
    "\n",
    "@torch.no_grad()\n",
    "def translate_batch(src, src_lens, max_len=MAX_LEN + 5):\n",
    "    model.eval()\n",
    "    src = src.to(device)\n",
    "    h, c = model.encoder(src, src_lens)\n",
    "    B = src.size(0)\n",
    "    token = torch.full((B,), SOS, dtype=torch.long, device=device)\n",
    "    result = []\n",
    "    for _ in range(max_len):\n",
    "        logits, h, c = model.decoder(token, h, c)\n",
    "        token = logits.argmax(1)\n",
    "        result.append(token)\n",
    "    result = torch.stack(result, dim=1).cpu().tolist()       # (B, max_len)\n",
    "    return [trg_vocab.decode(r) for r in result]\n",
    "\n",
    "def translate_sentence(sentence):\n",
    "    ids = torch.tensor([src_vocab.encode(tokenize(sentence))], dtype=torch.long)\n",
    "    lens = torch.tensor([ids.size(1)])\n",
    "    return \" \".join(translate_batch(ids, lens)[0])\n",
    "\n",
    "print(translate_sentence(\"how are you ?\"))"
   ]
